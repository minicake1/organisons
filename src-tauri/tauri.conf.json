{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organisons",
  "version": "0.8.0",
  "identifier": "fr.organisons.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Organisons",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "fr-FR"
      },
      "nsis": {
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3M0NCMjY1MUM3NTA2QkMKUldTOEJuVWNaYkk4Tjd2UUVrUkxWMldScFlTemNVdzZwK1gxeGdPOU53aXZBbDAwVnZ0eU5HRUkK",
      "endpoints": [
        "https://github.com/minicake1/organisons/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
